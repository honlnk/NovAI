{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://novai.local/schemas/seed.schema.json",
  "title": "NovAI OPFS 种子文件",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "createdAt", "files"],
  "properties": {
    "version": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "injectedLegacyBlock": { "type": "string", "enum": ["gardener"] },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[^/][^\\0]*[^/]$" },
      "additionalProperties": { "type": "string" }
    }
  }
}
